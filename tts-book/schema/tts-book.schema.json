{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CastMember": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "voice"
          ]
        },
        {
          "required": [
            "design"
          ]
        },
        {
          "required": [
            "xtts"
          ]
        }
      ],
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Zobrazované jméno postavy (jen pro přehled).",
          "title": "Name"
        },
        "voice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hlas: předpřipravený (např. 'Kore', 'Puck', 'Charon'), hlas z knihovny nebo ID vlastního hlasu 'voice_…' vytvořeného ve Voice design.",
          "title": "Voice"
        },
        "design": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Popis hlasu pro Voice design (např. 'starší laskavá žena, lehce chraplavá'). Automatické vytvoření hlasu zatím není hotové – vytvoř hlas v AI Studiu a jeho ID vlož do `voice`. Popis si tu nech jako dokumentaci.",
          "title": "Design"
        },
        "style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Krátký výchozí způsob přednesu postavy, např. 'klidně, pomaleji'. Identitu nese hlas – dlouhé popisy zhoršují stálost hlasu.",
          "title": "Style"
        },
        "xtts": {
          "anyOf": [
            {
              "$ref": "#/$defs/XttsVoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hlas pro engine xtts: referenční nahrávka nebo vestavěný hlas, volitelně nahrávky podle režie."
        }
      },
      "title": "CastMember",
      "type": "object"
    },
    "Chapter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID kapitoly. Když chybí, vygeneruje se z pořadí ('ch01', 'ch02', …).",
          "title": "Id"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Název kapitoly (čte se, pokud `read_titles`).",
          "title": "Title"
        },
        "speaker": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Výchozí mluvčí kapitoly (např. kapitola vyprávěná jinou postavou).",
          "title": "Speaker"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Režijní poznámka k přednesu (např. 'šeptem, ustaraně'). Poznámky se skládají za sebe: kniha → postava → kapitola → odstavec → segment.",
          "title": "Direction"
        },
        "language": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Jazyk této části, pokud se liší od nadřazené úrovně (BCP 47).",
          "title": "Language"
        },
        "read_title": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Přepíše `output.read_titles` pro tuto kapitolu.",
          "title": "Read Title"
        },
        "skip": {
          "default": false,
          "description": "Kapitolu vynechat z renderu.",
          "title": "Skip",
          "type": "boolean"
        },
        "paragraphs": {
          "description": "Odstavce. Prostý řetězec je zkratka pro odstavec jen s textem.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Paragraph"
              }
            ]
          },
          "minItems": 1,
          "title": "Paragraphs",
          "type": "array"
        }
      },
      "required": [
        "paragraphs"
      ],
      "title": "Chapter",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "default": "narrator",
          "description": "Výchozí mluvčí (klíč z `cast`).",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Speaker",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Režijní poznámka platná pro celou knihu (připojuje se ke všem ostatním).",
          "title": "Direction"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "gemini",
          "description": "TTS backend. 'gemini' = Gemini API (API klíč), 'xtts' = lokální XTTS v2 (coqui-tts, GPU), 'mock' = offline testovací tóny bez volání API.",
          "enum": [
            "gemini",
            "xtts",
            "mock"
          ],
          "title": "Name",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model enginu. Když chybí, použije se výchozí: gemini → 'gemini-3.8-flash-tts', xtts → 'tts_models/multilingual/multi-dataset/xtts_v2' (u xtts jde zadat i složku se staženým modelem).",
          "title": "Model"
        },
        "sample_rate": {
          "default": 24000,
          "description": "Vzorkovací frekvence generovaného audia v Hz.",
          "enum": [
            24000,
            16000
          ],
          "title": "Sample Rate",
          "type": "integer"
        },
        "max_chars": {
          "default": 2000,
          "description": "Nejvyšší počet znaků v jednom požadavku. Delší text se rozdělí po větách. Model vrátí max. ~655 s audia na požadavek.",
          "maximum": 8000,
          "minimum": 200,
          "title": "Max Chars",
          "type": "integer"
        },
        "api_key_env": {
          "default": "GEMINI_API_KEY",
          "description": "Název proměnné prostředí s API klíčem.",
          "title": "Api Key Env",
          "type": "string"
        }
      },
      "title": "Engine",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Název knihy (album v ID3 tazích).",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Autor (interpret v ID3 tazích).",
          "title": "Author"
        },
        "language": {
          "description": "Výchozí jazyk textu jako BCP 47 kód, např. 'cs-CZ', 'en-US', 'de'. Gemini jazyk detekuje sám; kód slouží dělení na věty, importu a dalším enginům. Lze přepsat u kapitoly, odstavce i segmentu.",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "title",
        "language"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Výstupní složka (relativně k souboru knihy). Výchozí je build/<název souboru>. Je v ní i cache vygenerovaných odstavců.",
          "title": "Dir"
        },
        "format": {
          "default": "mp3",
          "description": "Formát souborů kapitol.",
          "enum": [
            "mp3",
            "wav"
          ],
          "title": "Format",
          "type": "string"
        },
        "bitrate": {
          "default": "128k",
          "description": "Datový tok MP3, např. '96k', '128k', '192k'.",
          "pattern": "^\\d{2,3}k$",
          "title": "Bitrate",
          "type": "string"
        },
        "read_titles": {
          "default": true,
          "description": "Přečíst název kapitoly na jejím začátku (hlasem `defaults.speaker`).",
          "title": "Read Titles",
          "type": "boolean"
        },
        "pauses": {
          "$ref": "#/$defs/Pauses"
        }
      },
      "title": "Output",
      "type": "object"
    },
    "Paragraph": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "segments"
          ]
        }
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stabilní ID odstavce. Když chybí, vygeneruje se z pořadí (např. 'ch01.p003').",
          "title": "Id"
        },
        "text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Doslovný text odstavce. Buď `text`, nebo `segments`.",
          "title": "Text"
        },
        "segments": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Segment"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Odstavec složený z více částí (různí mluvčí / různá režie).",
          "title": "Segments"
        },
        "speaker": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mluvčí (klíč z `cast`). Když chybí, dědí se z nadřazené úrovně.",
          "title": "Speaker"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Režijní poznámka k přednesu (např. 'šeptem, ustaraně'). Poznámky se skládají za sebe: kniha → postava → kapitola → odstavec → segment.",
          "title": "Direction"
        },
        "language": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Jazyk této části, pokud se liší od nadřazené úrovně (BCP 47).",
          "title": "Language"
        },
        "pause_after": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s)?\\s*$",
                  "type": "string"
                }
              ],
              "description": "Délka v sekundách: číslo (0.8) nebo text ('800ms', '1.5s')."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ticho po odstavci (přepíše `output.pauses.paragraph`).",
          "title": "Pause After"
        },
        "skip": {
          "default": false,
          "description": "Odstavec vynechat z renderu.",
          "title": "Skip",
          "type": "boolean"
        }
      },
      "title": "Paragraph",
      "type": "object"
    },
    "Pauses": {
      "additionalProperties": false,
      "properties": {
        "paragraph": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 0.8,
          "description": "Ticho mezi odstavci.",
          "title": "Paragraph"
        },
        "segment": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 0.2,
          "description": "Ticho mezi segmenty uvnitř odstavce.",
          "title": "Segment"
        },
        "chunk": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 0.3,
          "description": "Ticho mezi částmi příliš dlouhého textu (dělení po větách).",
          "title": "Chunk"
        },
        "title": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 1.5,
          "description": "Ticho po přečteném názvu kapitoly.",
          "title": "Title"
        },
        "chapter_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 0.5,
          "description": "Ticho na začátku souboru kapitoly.",
          "title": "Chapter Start"
        },
        "chapter_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 2.0,
          "description": "Ticho na konci souboru kapitoly.",
          "title": "Chapter End"
        }
      },
      "title": "Pauses",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "Doslovný text. Režijní poznámky sem nepatří – jen do `direction`.",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mluvčí (klíč z `cast`). Když chybí, dědí se z nadřazené úrovně.",
          "title": "Speaker"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Režijní poznámka k přednesu (např. 'šeptem, ustaraně'). Poznámky se skládají za sebe: kniha → postava → kapitola → odstavec → segment.",
          "title": "Direction"
        },
        "language": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Jazyk této části, pokud se liší od nadřazené úrovně (BCP 47).",
          "title": "Language"
        }
      },
      "required": [
        "text"
      ],
      "title": "Segment",
      "type": "object"
    },
    "XttsVoice": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "reference"
          ]
        },
        {
          "required": [
            "speaker"
          ]
        }
      ],
      "properties": {
        "reference": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Referenční nahrávka hlasu (WAV, 6–30 s čisté řeči bez hudby a šumu) nebo seznam nahrávek. Cesta relativně k souboru knihy.",
          "title": "Reference"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vestavěný hlas XTTS (např. 'Claribel Dervla', 'Damien Black'). Buď `reference`, nebo `speaker`.",
          "title": "Speaker"
        },
        "styles": {
          "additionalProperties": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            ]
          },
          "description": "Nahrávky pro různé polohy hlasu: {klíčové slovo: nahrávka}. Když se klíčové slovo objeví ve složené režii (např. 'šeptem'), použije se jeho nahrávka; při více shodách vyhrává ta nejvíc vpravo (nejkonkrétnější úroveň). Jinak platí `reference` / `speaker`.",
          "propertyNames": {
            "minLength": 1
          },
          "title": "Styles",
          "type": "object"
        }
      },
      "title": "XttsVoice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Soubor knihy pro tts-book.",
  "properties": {
    "version": {
      "const": 1,
      "description": "Verze formátu souboru.",
      "title": "Version",
      "type": "integer"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "engine": {
      "$ref": "#/$defs/Engine"
    },
    "output": {
      "$ref": "#/$defs/Output"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "cast": {
      "description": "Obsazení: klíč je ID mluvčího, hodnota jeho hlas a styl.",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]*$": {
          "$ref": "#/$defs/CastMember"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Cast",
      "type": "object"
    },
    "lexicon": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Textové náhrady před syntézou (zkratky, výslovnost jmen). Celá slova, rozlišuje velikost písmen. Např. {'sv.': 'svatý'}.",
      "propertyNames": {
        "minLength": 1
      },
      "title": "Lexicon",
      "type": "object"
    },
    "chapters": {
      "items": {
        "$ref": "#/$defs/Chapter"
      },
      "minItems": 1,
      "title": "Chapters",
      "type": "array"
    }
  },
  "required": [
    "version",
    "meta",
    "cast",
    "chapters"
  ],
  "title": "tts-book",
  "type": "object"
}
